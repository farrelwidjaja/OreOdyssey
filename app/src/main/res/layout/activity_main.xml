<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.oreodyssey.game.core.GameView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/hudLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="8dp"
            android:layout_marginTop="104dp"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/hpBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="150dp"
                android:layout_height="12dp"
                android:max="100"
                android:progress="100"
                android:progressTint="#E53935" />

            <TextView
                android:id="@+id/tvHp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFE066"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TAS (B)" />

            <Button
                android:id="@+id/btnMap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PETA (M)" />

            <Button
                android:id="@+id/btnPause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="II" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLeft"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:text="◀"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnRight"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="8dp"
                android:text="▶"
                android:textSize="22sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnJump"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:text="▲"
            android:textSize="26sp" />

        <LinearLayout
            android:id="@+id/hotbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal" />

        <!-- Tombol Crystal Sage: muncul di kanan bawah, di atas tombol jump -->
        <Button
            android:id="@+id/btnSage"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="100dp"
            android:layout_marginBottom="90dp"
            android:text="💎 SAGE"
            android:textSize="11sp"
            android:backgroundTint="#AA5B3FBB"
            android:textColor="#FFFFFF" />
    </FrameLayout>

    <!-- Dialog Crystal Sage: overlay di tengah layar -->
    <LinearLayout
        android:id="@+id/sageDialog"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#EE1A1040"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦ Crystal Sage ✦"
            android:textColor="#C9B8FF"
            android:textSize="16sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp" />

        <!-- Shimmer Skeleton Loading saat AI sedang memproses respons -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/sageShimmer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:background="#558A65D4"
                    android:layout_marginBottom="8dp" />
                <View
                    android:layout_width="220dp"
                    android:layout_height="14dp"
                    android:background="#558A65D4"
                    android:layout_marginBottom="8dp" />
                <View
                    android:layout_width="150dp"
                    android:layout_height="14dp"
                    android:background="#558A65D4" />
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <TextView
            android:id="@+id/tvSageResponse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.4"
            android:text="Memuat..." />

        <Button
            android:id="@+id/btnSageClose"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:layout_marginTop="14dp"
            android:text="Tutup"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5B3FBB" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bagPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="64dp"
        android:background="#DD000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TAS  (tap item = pindah ke kotak bawah)"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <GridLayout
                android:id="@+id/bagGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="6" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap kotak bawah saat tas terbuka = balik ke tas"
                android:textColor="#AAAAAA"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnBagClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TUTUP" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CRAFTING"
                android:textColor="#FFE066"
                android:textSize="14sp" />

            <ScrollView
                android:layout_width="260dp"
                android:layout_height="230dp">

                <LinearLayout
                    android:id="@+id/recipeList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mapControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/btnMapIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+" />

        <Button
            android:id="@+id/btnMapOut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="−" />

        <Button
            android:id="@+id/btnMapClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TUTUP (M)" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AA000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/tvSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="#FFE066"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnAction"
            android:layout_width="240dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnNew"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:text="GAME BARU (hapus save)" />

        <Button
            android:id="@+id/btnChar"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:text="UBAH KARAKTER" />

        <Button
            android:id="@+id/btnExit"
            android:layout_width="240dp"
            android:layout_height="wrap_content" />
    </LinearLayout>
</FrameLayout>