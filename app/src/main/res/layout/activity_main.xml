<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.oreodyssey.game.core.GameView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/hudLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="8dp"
            android:layout_marginTop="104dp"
            android:background="#AA121526"
            android:padding="6dp"
            android:orientation="vertical">

            <!-- Avatar Karakter & HP Bar -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.oreodyssey.game.ui.CharacterPreview
                    android:id="@+id/charAvatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPlayerNick"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/hpBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="130dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="2dp"
                        android:max="100"
                        android:progress="100"
                        android:progressTint="#E53935" />

                    <TextView
                        android:id="@+id/tvHp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFCDD2"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Indikator Kedalaman, Koin & Waktu -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDepth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⛏️ 0m"
                    android:textColor="#80D8FF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvCoins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="🪙 100"
                    android:textColor="#FFD54F"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="#FFE066"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TAS (B)" />

            <Button
                android:id="@+id/btnMap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PETA (M)" />

            <Button
                android:id="@+id/btnPause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="II" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLeft"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:text="◀"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnRight"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="8dp"
                android:text="▶"
                android:textSize="22sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnJump"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:text="▲"
            android:textSize="26sp" />

        <LinearLayout
            android:id="@+id/hotbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal" />

        <!-- Floating Tooltip untuk info Item terpilih / disentuh -->
        <LinearLayout
            android:id="@+id/itemTooltipCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="60dp"
            android:background="#EE181824"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvTooltipName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTooltipStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#8BE594"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Tombol Crystal Sage: muncul di kanan bawah dengan animasi Lottie -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="96dp"
            android:layout_marginBottom="90dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieSageIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                app:lottie_rawRes="@raw/crystal_pulse"
                app:lottie_autoPlay="true"
                app:lottie_loop="true" />

            <Button
                android:id="@+id/btnSage"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="PETUNJUK"
                android:textSize="11sp"
                android:backgroundTint="#CC263238"
                android:textColor="#80DEEA" />
        </LinearLayout>
    </FrameLayout>

    <!-- Dialog Crystal Sage: overlay di tengah layar -->
    <LinearLayout
        android:id="@+id/sageDialog"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#F21E232E"
        android:orientation="vertical"
        android:padding="18dp"
        android:visibility="gone">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieSageDialog"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            app:lottie_rawRes="@raw/crystal_pulse"
            app:lottie_autoPlay="true"
            app:lottie_loop="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Petunjuk Gua"
            android:textColor="#80DEEA"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp" />

        <!-- Shimmer Skeleton Loading saat membaca respons -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/sageShimmer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:background="#33607D8B"
                    android:layout_marginBottom="8dp" />
                <View
                    android:layout_width="220dp"
                    android:layout_height="12dp"
                    android:background="#33607D8B"
                    android:layout_marginBottom="8dp" />
                <View
                    android:layout_width="150dp"
                    android:layout_height="12dp"
                    android:background="#33607D8B" />
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <TextView
            android:id="@+id/tvSageResponse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#ECEFF1"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.3"
            android:text="Membaca situasi sekitar..." />

        <Button
            android:id="@+id/btnSageClose"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:layout_marginTop="14dp"
            android:text="Tutup"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bagPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="64dp"
        android:background="#DD000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TAS  (tap = pindah ke kotak bawah)"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvBagCoins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🪙 100"
                    android:textColor="#FFD54F"
                    android:textSize="12sp" />
            </LinearLayout>

            <GridLayout
                android:id="@+id/bagGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="6" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap kotak bawah saat tas terbuka = balik ke tas"
                android:textColor="#AAAAAA"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnBagClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TUTUP" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CRAFTING"
                android:textColor="#FFE066"
                android:textSize="14sp" />

            <ScrollView
                android:layout_width="260dp"
                android:layout_height="230dp">

                <LinearLayout
                    android:id="@+id/recipeList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mapControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/btnMapIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+" />

        <Button
            android:id="@+id/btnMapOut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="−" />

        <Button
            android:id="@+id/btnMapClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TUTUP (M)" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AA000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/tvSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="#FFE066"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnAction"
            android:layout_width="240dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnNew"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:text="GAME BARU (hapus save)" />

        <Button
            android:id="@+id/btnChar"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:text="UBAH KARAKTER" />

        <Button
            android:id="@+id/btnExit"
            android:layout_width="240dp"
            android:layout_height="wrap_content" />
    </LinearLayout>
</FrameLayout>